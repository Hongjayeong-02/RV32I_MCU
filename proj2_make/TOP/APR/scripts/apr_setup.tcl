########################################
# apr_setup.tcl : common settings for the MCU P&R (core-only, M4)
#   run from APR/work :  innovus -files ../scripts/run_all.tcl -log ../log/apr
########################################
set DESIGN     mcu_top
set SYN_DIR    ../../SYN/netlist_mcu_10ns
set NETLIST    $SYN_DIR/mcu_top_10ns.v
set SDC        $SYN_DIR/mcu_top_10ns.sdc

# floorplan knobs (spec 11 : utilization sweep 50 / 60 / 70 %)
if {![info exists UTIL]}   { set UTIL   0.60 }
if {![info exists MARGIN]} { set MARGIN 15 }

# PDK paths : APR/scripts/pdk_setup.tcl, generated by make_pdk_setup.sh (git-ignored)
set PDK_LINES {}
proc set_pdk_line {l} { global PDK_LINES ; lappend PDK_LINES $l }
source ../scripts/pdk_setup.tcl
