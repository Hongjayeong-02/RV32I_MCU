########################################
# apr_setup_chip.tcl : common settings for the MCU chip-level P&R (M5, PAD ring)
#   run from APR/work_chip :  innovus -files ../scripts_chip/run_all_chip.tcl -log ../log/apr_chip
########################################
set DESIGN     mcu_chip_top
set SYN_DIR    ../../SYN/netlist_chip_10ns
set NETLIST    $SYN_DIR/mcu_chip_top_10ns.v
set SDC        $SYN_DIR/mcu_chip_top_10ns.sdc

# die (um, square). core = die - 2 x (PAD 240 + ring channel 30)
#   1000 -> core about 460 x 460 um, std-cell utilization about 52 % (core-limited, 22 PADs fit easily)
if {![info exists DIE]} { set DIE 1000 }

# PDK paths : generated by make_pdk_setup_chip.sh (git-ignored)
source ../scripts_chip/pdk_lef_chip.tcl
